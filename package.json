{
  "name": "verifactia",
  "version": "0.1.0",
  "description": "VerifactIA — convierte noticias e informacion publica verificable en guiones listos para TV, con verificacion de evidencia y revision humana. Documentado en Notion.",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "test": "node --test test/pipeline.test.js",
    "test:stress": "node --test test/stress.test.js",
    "ingest": "node -e \"require('./lib/ingest').ingestarTodo()\""
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@notionhq/client": "^2.2.15",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "nodemailer": "^6.10.1"
  },
  "keywords": [
    "fact-checking",
    "news",
    "broadcast",
    "tv-script",
    "ai-agent",
    "notion",
    "verification"
  ],
  "license": "MIT"
}
