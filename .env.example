# ─────────────────────────────────────────────────────────────
# VerifactIA — Configuración (copia a ".env" y rellena)
# ─────────────────────────────────────────────────────────────

PORT=4800

# ── Cerebro de IA: cascada de proveedores (OpenAI-compatible) ──
# Se intentan en orden; el primero que responda gana. Fallback a reglas.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=sentia-auto
AI_TIMEOUT_MS=12000

# ── Ingesta de datos ──
# GDELT da 429 desde algunas redes; déjalo en false si falla (TVN RSS basta).
GDELT_ENABLED=false
# Ventana de días para sismos recientes (USGS) y tendencias.
USGS_DIAS=60

# ── Alertas al editor (opcional). Si no se configura SMTP, modo log. ──
ALERT_EMAIL_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
APP_PUBLIC_URL=

# ── Notion (opcional, si se documenta vía API) ──
NOTION_TOKEN=
